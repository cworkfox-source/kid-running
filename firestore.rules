rules_version='2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function backupPath(uid, deviceId, backupId) {
      return /databases/$(database)/documents/users/$(uid)/devices/$(deviceId)/backups/$(backupId);
    }
    function countNow(uid) {
      return exists(userPath(uid)) && get(userPath(uid)).data.keys().hasAny(['completeCount'])
        ? get(userPath(uid)).data.completeCount
        : 0;
    }
    function countAfter(uid) {
      return existsAfter(userPath(uid)) && getAfter(userPath(uid)).data.keys().hasAny(['completeCount'])
        ? getAfter(userPath(uid)).data.completeCount
        : 0;
    }
    function isClockWrite(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.lastBackupAt == request.time
        && request.resource.data.lastBackupId is string
        && request.resource.data.lastBackupId.size() > 0
        && request.resource.data.lastBackupId.size() <= 128;
    }
    function clockCreate(uid) {
      return isClockWrite(uid)
        && request.resource.data.keys().hasOnly(['uid','lastBackupAt','lastBackupId','completeCount'])
        && (!request.resource.data.keys().hasAny(['completeCount']) || request.resource.data.completeCount == 0);
    }
    function clockCreateNoCount(uid) {
      return isClockWrite(uid)
        && request.resource.data.keys().hasOnly(['uid','lastBackupAt','lastBackupId']);
    }
    function clockUpdate(uid) {
      return isClockWrite(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastBackupAt','lastBackupId','uid'])
        && (!resource.data.keys().hasAny(['lastBackupAt']) || request.time >= resource.data.lastBackupAt + duration.value(60,'s'));
    }
    function idField(field) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= 128;
    }
    function countBump(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completeCount','lastCompletedBackupId','lastCompletedDeviceId'])
        && request.resource.data.completeCount is int
        && request.resource.data.completeCount == resource.data.get('completeCount', 0) + 1
        && request.resource.data.completeCount >= 1
        && request.resource.data.completeCount <= 10
        && idField('lastCompletedBackupId')
        && idField('lastCompletedDeviceId')
        && exists(backupPath(uid, request.resource.data.lastCompletedDeviceId, request.resource.data.lastCompletedBackupId))
        && get(backupPath(uid, request.resource.data.lastCompletedDeviceId, request.resource.data.lastCompletedBackupId)).data.status == 'uploading'
        && existsAfter(backupPath(uid, request.resource.data.lastCompletedDeviceId, request.resource.data.lastCompletedBackupId))
        && getAfter(backupPath(uid, request.resource.data.lastCompletedDeviceId, request.resource.data.lastCompletedBackupId)).data.status == 'complete';
    }
    function countDrop(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completeCount','lastDeletedBackupId','lastDeletedDeviceId'])
        && request.resource.data.completeCount is int
        && request.resource.data.completeCount == resource.data.get('completeCount', 0) - 1
        && request.resource.data.completeCount >= 0
        && request.resource.data.completeCount <= 9
        && idField('lastDeletedBackupId')
        && idField('lastDeletedDeviceId')
        && exists(backupPath(uid, request.resource.data.lastDeletedDeviceId, request.resource.data.lastDeletedBackupId))
        && get(backupPath(uid, request.resource.data.lastDeletedDeviceId, request.resource.data.lastDeletedBackupId)).data.status == 'complete'
        && !existsAfter(backupPath(uid, request.resource.data.lastDeletedDeviceId, request.resource.data.lastDeletedBackupId));
    }
    function freshBackupClock(uid,backupId) {
      return existsAfter(userPath(uid))
        && getAfter(userPath(uid)).data.uid == uid
        && getAfter(userPath(uid)).data.lastBackupAt == request.time
        && getAfter(userPath(uid)).data.lastBackupId == backupId;
    }
    function validBackupCreate(uid,deviceId,backupId) {
      return request.resource.data.keys().hasOnly(['schemaVersion','backupId','uid','deviceId','localRevision','contentHash','recordCount','childCount','chunkCount','status','summary','createdAt'])
        && request.resource.data.schemaVersion == 1 && request.resource.data.uid == uid && request.resource.data.deviceId == deviceId && request.resource.data.backupId == backupId
        && request.resource.data.localRevision is int && request.resource.data.localRevision >= 0 && request.resource.data.contentHash is string && request.resource.data.contentHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.recordCount is int && request.resource.data.recordCount >= 0 && request.resource.data.recordCount <= 3000 && request.resource.data.childCount is int && request.resource.data.childCount >= 0 && request.resource.data.childCount <= 20
        && request.resource.data.chunkCount is int && request.resource.data.chunkCount >= 1 && request.resource.data.chunkCount <= 4 && request.resource.data.status == 'uploading' && request.resource.data.summary is map && request.resource.data.createdAt == request.time && freshBackupClock(uid,backupId);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && (clockCreate(uid) || clockCreateNoCount(uid));
      allow update: if isOwner(uid) && (clockUpdate(uid) || countBump(uid) || countDrop(uid));
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(uid);

        match /backups/{backupId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && validBackupCreate(uid,deviceId,backupId);
          allow update: if isOwner(uid)
            && resource.data.status == 'uploading'
            && request.resource.data.status == 'complete'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','completedAt'])
            && request.resource.data.completedAt == request.time
            && countAfter(uid) == countNow(uid) + 1
            && countAfter(uid) <= 10
            && getAfter(userPath(uid)).data.lastCompletedBackupId == backupId
            && getAfter(userPath(uid)).data.lastCompletedDeviceId == deviceId;
          allow delete: if isOwner(uid) && (
            (resource.data.status != 'complete' && countAfter(uid) == countNow(uid))
            || (resource.data.status == 'complete'
              && countAfter(uid) == countNow(uid) - 1
              && countAfter(uid) >= 0
              && getAfter(userPath(uid)).data.lastDeletedBackupId == backupId
              && getAfter(userPath(uid)).data.lastDeletedDeviceId == deviceId)
          );

          match /chunks/{chunkId} {
            allow read: if isOwner(uid);
            allow create: if isOwner(uid)
              && int(chunkId) == request.resource.data.index
              && request.resource.data.keys().hasOnly(['index','data','digest']) && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.data is string && request.resource.data.data.size() <= 262144 && request.resource.data.digest is string && request.resource.data.digest.matches('^[0-9a-f]{64}$')
              && request.resource.data.index < get(/databases/$(database)/documents/users/$(uid)/devices/$(deviceId)/backups/$(backupId)).data.chunkCount
              && get(/databases/$(database)/documents/users/$(uid)/devices/$(deviceId)/backups/$(backupId)).data.status == 'uploading';
            allow update: if false;
            allow delete: if isOwner(uid);
          }
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
